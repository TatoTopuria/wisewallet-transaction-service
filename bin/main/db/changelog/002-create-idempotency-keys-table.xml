<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="002-create-idempotency-keys-table" author="wisewallet-migrations" runOnChange="false" failOnError="true">
        <createTable tableName="idempotency_keys" schemaName="transaction">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="key" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="response_status" type="INT">
                <constraints nullable="true"/>
            </column>
            <column name="response_body" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint
                tableName="idempotency_keys"
                schemaName="transaction"
                columnNames="key, user_id"
                constraintName="uq_idempotency_key_user"/>

        <sql>
            CREATE INDEX idx_idempotency_keys_expires
                ON transaction.idempotency_keys (expires_at);
        </sql>
    </changeSet>

</databaseChangeLog>
