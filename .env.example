# Copy this file to .env and fill in the values for your local environment.
# NEVER commit .env to source control.

SPRING_PROFILES_ACTIVE=local

# Database
DB_URL=jdbc:postgresql://localhost:5433/wisewallet
DB_USERNAME=wisewallet
DB_PASSWORD=dev_password

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Account Service
ACCOUNT_SERVICE_URL=http://localhost:8081

# Internal API key (shared with account-service)
INTERNAL_API_KEY=local-internal-key-replace-this

# OpenTelemetry (optional for local)
OTEL_SERVICE_NAME=wisewallet-transaction-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
